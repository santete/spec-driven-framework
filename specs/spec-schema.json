{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystone.dev/spec-schema.json",
  "title": "Keystone Spec Frontmatter",
  "description": "Schema for YAML frontmatter of any Keystone spec artifact under specs/. PRD §8.2.",
  "type": "object",
  "required": ["id", "type", "title", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ENT|FEAT|REQ|NFR|API|SCHEMA|AC|PROJECT|SDD)-[A-Z][A-Z0-9_-]*$",
      "description": "Stable ID grammar §8.1: <TYPE>-<DOMAIN>[-<NNN>]"
    },
    "type": {
      "enum": ["entity", "feature", "requirement", "nfr", "api", "schema", "ac", "project", "sdd"]
    },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$" },
    "status": {
      "enum": ["draft", "approved", "deprecated", "retired", "proposed", "rejected", "superseded"]
    },
    "priority": { "enum": ["must", "should", "could"] },
    "owner": { "type": "string" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "relations": {
      "type": "object",
      "properties": {
        "refines": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "satisfies": { "type": "array", "items": { "type": "string" } },
        "verifies": { "type": "array", "items": { "type": "string" } },
        "supersedes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": { "type": "object" }
    },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Z][A-Z0-9_-]*$" },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["metric", "threshold", "measured_by"],
      "properties": {
        "metric": { "type": "string" },
        "threshold": { "type": "number" },
        "measured_by": { "type": "string" }
      }
    },
    "openapi": { "type": "object" },
    "openapi_ref": { "type": "string" },
    "openapi_path": { "type": "string" },
    "openapi_method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    "json_schema": { "type": "object" },
    "profile": { "type": "string" },
    "profile_source": { "enum": ["catalog", "custom_repo"] },
    "custom_profile": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "uncertified_acknowledged": { "type": "boolean" }
      }
    },
    "stack": { "type": "object" },
    "constraints": { "type": "object" },
    "non_functional_defaults": { "type": "object" },
    "codegen_conventions": { "type": "object" },
    "feedback_style": { "enum": ["concise", "detailed", "coaching"] },
    "rework": { "type": "object" },
    "derived_from": { "type": "object" },
    "components": { "type": "array" },
    "sequencing": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array" },
    "customer_approval": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "entity" } }, "required": ["type"] },
      "then": { "required": ["fields", "invariants"] }
    },
    {
      "if": { "properties": { "type": { "const": "requirement" } }, "required": ["type"] },
      "then": { "required": ["priority"] }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "requirement" },
          "priority": { "const": "must" }
        },
        "required": ["type", "priority"]
      },
      "then": { "required": ["acceptance_criteria"] }
    },
    {
      "if": { "properties": { "type": { "const": "nfr" } }, "required": ["type"] },
      "then": { "required": ["budget"] }
    },
    {
      "if": { "properties": { "type": { "const": "api" } }, "required": ["type"] },
      "then": {
        "anyOf": [
          { "required": ["openapi"] },
          { "required": ["openapi_ref", "openapi_path", "openapi_method"] }
        ]
      }
    },
    {
      "if": { "properties": { "type": { "const": "schema" } }, "required": ["type"] },
      "then": { "required": ["json_schema"] }
    },
    {
      "if": { "properties": { "type": { "const": "project" } }, "required": ["type"] },
      "then": { "required": ["profile", "stack"] }
    }
  ]
}
